{
  "name": "thetribeofdan/laravel_vault",
  "description": "A Laravel package that helps you easily integrate and manage secrets from HashiCorp Vault, with caching and env/config-style access.",
  "keywords": [
    "hash",
    "config",
    "hashicorp",
    "vault",
    "Laravel",
    "secret",
    "encryption",
    "cybersecurity",
    "security",
    "env"
  ],
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "VaultImplementation\\VaultPackage\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "VaultImplementation\\VaultPackage\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "VaultImplementation\\VaultPackage\\VaultPackageServiceProvider"
      ]
    }
  },
  "authors": [
    {
      "name": "Daniel Fiyinfoluwa Egbeleke",
      "email": "fiyinfoluwaegbeleke@gmail.com",
      "role": "Developer",
      "homepage": "https://github.com/thetribeofdan"
    }
  ],
  "homepage": "https://github.com/thetribeofdan/laravel_vault",
  "support": {
    "issues": "https://github.com/thetribeofdan/laravel_vault/issues",
    "source": "https://github.com/thetribeofdan/laravel_vault"
  },
  "require": {
    "php": "^8.0",
    "illuminate/cache": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
    "illuminate/http": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
    "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0"
  },
  "scripts": {
    "test": "phpunit"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
